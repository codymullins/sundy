@page "/auth/callback"

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Authentication</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #121212;
            color: #e0e0e0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        .container { text-align: center; padding: 40px; }
        h2 { margin: 0 0 12px 0; font-size: 24px; }
        p { margin: 0; color: #808080; font-size: 14px; }
        .error { color: #ef4444; }
        .spinner {
            width: 48px; height: 48px;
            border: 3px solid #333; border-top-color: #10b981;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="container" id="content">
        <div class="spinner"></div>
        <h2>Completing authentication...</h2>
        <p>Please wait</p>
    </div>

    <script>
        (async function() {
            const container = document.getElementById('content');
            const params = new URLSearchParams(window.location.search);
            const code = params.get('code');
            const state = params.get('state');
            const error = params.get('error');
            const errorDescription = params.get('error_description');

            function showError(title, message) {
                container.innerHTML = `
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    <h2>${title}</h2>
                    <p class="error">${message}</p>`;
            }

            function showSuccess() {
                container.innerHTML = `
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <h2>Authentication Complete</h2>
                    <p>This window will close automatically...</p>`;
            }

            if (error) {
                showError('Authentication Failed', errorDescription || error);
                return;
            }

            if (!code) {
                showError('Authentication Failed', 'No authorization code received');
                return;
            }

            // Wait for Tauri to be available
            let attempts = 0;
            while (!window.__TAURI__ && attempts < 50) {
                await new Promise(r => setTimeout(r, 100));
                attempts++;
            }

            if (!window.__TAURI__) {
                showError('Error', 'Tauri not available');
                return;
            }

            try {
                console.log('Emitting oauth-callback event');
                await window.__TAURI__.event.emit('oauth-callback', { code, state });
                showSuccess();

                setTimeout(async () => {
                    try {
                        const win = window.__TAURI__.window.getCurrentWindow();
                        await win.close();
                    } catch (e) { console.log('Close error:', e); }
                }, 1000);
            } catch (e) {
                showError('Error', e.message || 'Failed to complete authentication');
            }
        })();
    </script>
</body>
</html>
