@using Sundy.Core.Settings
@inject ISettingsService SettingsService

@if (_showBanner)
{
    <div class="demo-mode-banner">
        <div class="demo-banner-content">
            <svg class="demo-banner-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="demo-banner-text">
                <strong>Demo Mode:</strong> Telemetry is enabled by default. Go to <strong>Settings &gt; Privacy</strong> to disable it.
            </span>
        </div>
        <button class="demo-banner-dismiss" @onclick="DismissBanner" title="Dismiss">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
}

@code {
    [Parameter]
    public EventCallback OnDismissed { get; set; }

    private bool _showBanner;

    protected override async Task OnInitializedAsync()
    {
        var demoMode = await SettingsService.GetDemoModeAsync();
        var dismissed = await SettingsService.GetDemoBannerDismissedAsync();

        _showBanner = demoMode && !dismissed;
    }

    private async Task DismissBanner()
    {
        await SettingsService.SetDemoBannerDismissedAsync(true);
        _showBanner = false;
        await OnDismissed.InvokeAsync();
    }
}
