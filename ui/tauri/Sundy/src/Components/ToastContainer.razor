@using Sundy.Services
@inject IToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="toast toast-@toast.Type.ToString().ToLowerInvariant()">
            <div class="toast-icon">
                @if (toast.Type == ToastType.Error)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                }
                else if (toast.Type == ToastType.Success)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                }
            </div>
            <span class="toast-message">@toast.Message</span>
            <button class="toast-dismiss" @onclick="() => Dismiss(toast.Id)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }
</div>

@code {
    private Timer? _timer;

    protected override void OnInitialized()
    {
        ToastService.OnChange += HandleChange;
        // Timer to auto-refresh and remove expired toasts
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Dismiss(Guid id)
    {
        ToastService.Dismiss(id);
    }

    public void Dispose()
    {
        ToastService.OnChange -= HandleChange;
        _timer?.Dispose();
    }
}
